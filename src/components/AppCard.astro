---
const {
  name,
  label,
  description,
  href,
  icon = '✦',
} = Astro.props;
---

<article class="app-card">
  <div class="app-icon" aria-hidden="true">
    {icon}
  </div>

  <h3>{name}</h3>

  <p class="app-label">
    {label}
  </p>

  <p class="app-description">
    {description}
  </p>

  <a href={href} class="detail-link">
    詳細を見る
    <span aria-hidden="true">→</span>
  </a>
</article>
