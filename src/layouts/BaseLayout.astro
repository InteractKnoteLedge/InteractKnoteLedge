---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StudioHeader from '../components/StudioHeader.astro';
import StudioFooter from '../components/StudioFooter.astro';
import ProductMotion from '../components/ProductMotion.astro';
import '../styles/global.css';

const {
  title = 'Noveris',
  description = 'Noverisは、学びと日常を次のステージへ導くアプリ開発集団です。',
  page,
} = Astro.props;

// ホームは専用のヘッダーとフッターを持つため、共通レイアウトとの二重表示を避けます。
const isHome = page === 'home';
const isProduct = page === 'product';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />

    <!-- スマホ表示にも対応するために必須 -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  </head>

  <body class:list={{ 'page-home': isHome, 'page-product': isProduct }}>
    {isHome ? (
      <slot />
    ) : isProduct ? (
      <>
        <StudioHeader />

        <main>
          <slot />
        </main>

        <StudioFooter />
        <ProductMotion />
      </>
    ) : (
      <>
        <Header />

        <main>
          <slot />
        </main>

        <Footer />
      </>
    )}
  </body>
</html>
