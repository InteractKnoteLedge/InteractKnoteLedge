---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="しまっぷ｜Noveris"
  description="しまっぷは、家のモノの収納場所と外出時の持ち物準備をまとめて管理するアプリです。"
>
  <section class="product-hero">
    <div>
      <p class="breadcrumb">
        <a href="/">ホーム</a>
        <span>›</span>
        <a href="/#apps">アプリ</a>
        <span>›</span>
        しまっぷ
      </p>

      <p class="eyebrow">Noveris App</p>

      <h1>しまっぷ</h1>

      <h2>
        モノの場所も、持ち物準備も、<br />
        これひとつで。
      </h2>

      <p>
        しまっぷは、家にあるモノの収納場所と、
        外出時の持ち物準備をまとめて管理するアプリです。
        「あれ、どこに置いたっけ？」「今日、何を持っていけばいい？」
        を解決します。
      </p>
    </div>

    <div class="studiair-carousel-wrap shimappu-carousel" aria-label="しまっぷアプリのスクリーンショット" data-kn-carousel>
      <div class="studiair-carousel-track" data-kn-track>
        <!-- Plachieveと同じiPhone筐体で、しまっぷの主要画面を表示します。 -->
        {[
          { src: '/images/shimappu-ss1.png', label: 'モノ一覧画面', clipId: 'shimappu-clip-1' },
          { src: '/images/shimappu-ss2.png', label: '収納一覧画面', clipId: 'shimappu-clip-2' },
          { src: '/images/shimappu-ss3.png', label: '予定と持ち物テンプレート画面', clipId: 'shimappu-clip-3' },
          { src: '/images/shimappu-ss4.png', label: '収納一覧と通知画面', clipId: 'shimappu-clip-4' },
        ].map((screenshot) => (
          <div class="studiair-slide">
            <svg
              class="studiair-tablet-svg plachieve-phone-svg"
              viewBox="0 0 360 780"
              xmlns="http://www.w3.org/2000/svg"
              role="img"
              aria-label={screenshot.label}
            >
              <defs>
                <clipPath id={screenshot.clipId}>
                  <rect x="8" y="28" width="344" height="716" rx="24" ry="24" />
                </clipPath>
              </defs>
              <rect x="0" y="0" width="360" height="780" rx="40" ry="40" fill="#061b3a" />
              <rect x="8" y="28" width="344" height="716" rx="24" ry="24" fill="#f7fbff" />
              <image
                href={screenshot.src}
                x="8"
                y="28"
                width="344"
                height="716"
                preserveAspectRatio="xMidYMid slice"
                clip-path={`url(#${screenshot.clipId})`}
              />
              <rect x="156" y="10" width="48" height="8" rx="4" fill="#0d2244" />
              <rect x="140" y="752" width="80" height="4" rx="2" fill="#0d2244" />
              <rect x="-5" y="140" width="5" height="40" rx="2.5" fill="#04122e" />
              <rect x="-5" y="192" width="5" height="40" rx="2.5" fill="#04122e" />
              <rect x="360" y="170" width="5" height="56" rx="2.5" fill="#04122e" />
            </svg>
          </div>
        ))}
      </div>

      <div class="studiair-nav" role="tablist" aria-label="スクリーンショットを選択">
        <button class="studiair-nav-btn" data-kn-prev aria-label="前のスクリーンショット">&#8249;</button>
        <button class="studiair-dot is-active" data-kn-idx="0" role="tab" aria-label="スクリーンショット1" aria-selected="true"></button>
        <button class="studiair-dot" data-kn-idx="1" role="tab" aria-label="スクリーンショット2" aria-selected="false"></button>
        <button class="studiair-dot" data-kn-idx="2" role="tab" aria-label="スクリーンショット3" aria-selected="false"></button>
        <button class="studiair-dot" data-kn-idx="3" role="tab" aria-label="スクリーンショット4" aria-selected="false"></button>
        <button class="studiair-nav-btn" data-kn-next aria-label="次のスクリーンショット">&#8250;</button>
      </div>
    </div>

    <script>
      // カルーセルの操作方法をPlachieveページと統一します。
      (function () {
        const carousel = document.querySelector('[data-kn-carousel]');
        if (!carousel) return;

        const track = carousel.querySelector('[data-kn-track]');
        const dots = carousel.querySelectorAll('[data-kn-idx]');
        const previousButton = carousel.querySelector('[data-kn-prev]');
        const nextButton = carousel.querySelector('[data-kn-next]');
        const total = dots.length;
        let current = 0;
        let timer;

        function goTo(index) {
          current = (index + total) % total;
          track.style.transform = `translateX(-${current * (100 / total)}%)`;
          dots.forEach((dot, dotIndex) => {
            dot.classList.toggle('is-active', dotIndex === current);
            dot.setAttribute('aria-selected', String(dotIndex === current));
          });
        }

        function stopAuto() {
          clearInterval(timer);
        }

        function startAuto() {
          stopAuto();
          timer = setInterval(() => goTo(current + 1), 3500);
        }

        dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            goTo(Number(dot.dataset.knIdx));
            startAuto();
          });
        });

        previousButton.addEventListener('click', () => {
          goTo(current - 1);
          startAuto();
        });
        nextButton.addEventListener('click', () => {
          goTo(current + 1);
          startAuto();
        });

        carousel.addEventListener('mouseenter', stopAuto);
        carousel.addEventListener('mouseleave', startAuto);

        let touchStartX = 0;
        carousel.addEventListener('touchstart', (event) => {
          touchStartX = event.touches[0].clientX;
          stopAuto();
        }, { passive: true });
        carousel.addEventListener('touchend', (event) => {
          const difference = touchStartX - event.changedTouches[0].clientX;
          if (Math.abs(difference) > 40) goTo(current + (difference > 0 ? 1 : -1));
          startAuto();
        }, { passive: true });

        let dragStartX = 0;
        let isDragging = false;
        track.addEventListener('mousedown', (event) => {
          dragStartX = event.clientX;
          isDragging = true;
          stopAuto();
        });
        window.addEventListener('mouseup', (event) => {
          if (!isDragging) return;
          isDragging = false;
          const difference = dragStartX - event.clientX;
          if (Math.abs(difference) > 40) goTo(current + (difference > 0 ? 1 : -1));
          startAuto();
        });

        startAuto();
      })();
    </script>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">しまっぷの主な機能</p>
      <h2>収納から持ち物準備まで、一元管理</h2>
    </div>

    <div class="feature-grid">
      <article class="feature-card">
        <h3>収納管理</h3>
        <p>
          部屋・棚・バッグなどの収納場所を登録し、
          どこに何があるかをいつでも確認できます。
          「あれ、どこ？」がなくなります。
        </p>
      </article>

      <article class="feature-card">
        <h3>モノ管理</h3>
        <p>
          モノの名前、写真、タグ、置き場所などを保存・検索できます。
          大切なモノをしっかり記録して、必要なときにすぐ見つけられます。
        </p>
      </article>

      <article class="feature-card">
        <h3>予定と持ち物管理</h3>
        <p>
          日付ごとに必要な持ち物を登録し、
          指定時刻に通知できます。
          大事な忘れ物を防ぎます。
        </p>
      </article>

      <article class="feature-card">
        <h3>持ち物テンプレ</h3>
        <p>
          通学・仕事・旅行など、よく使う持ち物の組み合わせをテンプレとして保存し、
          予定へワンタップで適用できます。
        </p>
      </article>

      <article class="feature-card">
        <h3>サブテンプレ</h3>
        <p>
          雨の日セットやPC作業セットなど、
          追加したい持ち物だけを小さなセットとして管理できます。
          柔軟な持ち物カスタマイズが可能です。
        </p>
      </article>

      <article class="feature-card">
        <h3>リマインダー</h3>
        <p>
          翌日の準備通知や、登録した場所への到着・出発に応じた
          位置情報通知に対応。準備し忘れを防ぎます。
        </p>
      </article>

      <article class="feature-card wide-card">
        <h3>ショートカット・ウィジェット連携</h3>
        <p>
          モノの移動や今日の持ち物確認を、アプリを開かずに行えます。
          ホーム画面ウィジェットやiOSショートカットと連携し、
          毎日の動線にしまっぷをシームレスに組み込めます。
        </p>
      </article>
    </div>
  </section>

  <section class="flow-section">
    <div class="section-heading">
      <h2>しまっぷの活用フロー</h2>
    </div>

    <div class="flow-grid five">
      <article>
        <span>1</span>
        <h3>収納場所を登録</h3>
        <p>部屋・棚・バッグなどをアプリに登録します。</p>
      </article>

      <article>
        <span>2</span>
        <h3>モノを登録</h3>
        <p>持ち物に写真・タグ・収納場所を紐づけて保存します。</p>
      </article>

      <article>
        <span>3</span>
        <h3>テンプレを作成</h3>
        <p>通学・仕事・旅行など目的別の持ち物セットを登録します。</p>
      </article>

      <article>
        <span>4</span>
        <h3>予定に適用</h3>
        <p>日付ごとの予定にテンプレを当てはめて持ち物を確定します。</p>
      </article>

      <article>
        <span>5</span>
        <h3>通知で準備</h3>
        <p>指定時刻や出発・到着に合わせて通知を受け取ります。</p>
      </article>
    </div>
  </section>

  <section class="highlight-section">
    <div>
      <h2>しまっぷの革新ポイント</h2>

      <p>
        しまっぷは、「どこにある？」と「何を持っていく？」を
        ひとつのアプリで解決します。
        収納管理と持ち物準備を連携させることで、
        毎日の出発をもっとスムーズにします。
      </p>
    </div>

    <div class="checkpoint-ui" aria-hidden="true">
      <span>収納</span>
      <span>モノ</span>
      <span>予定</span>
      <span class="active">準備</span>
      <span>通知</span>
    </div>
  </section>

  <section class="contact-section">
    <h2>しまっぷについて相談する</h2>

    <p>
      しまっぷに関するご意見・ご要望はお気軽にお問い合わせください。
    </p>

    <div class="hero-actions center">
      <a href="/contact" class="primary-button">お問い合わせ</a>
      <a href="/" class="secondary-button">ホームへ戻る</a>
    </div>
  </section>

  <section class="studiair-legal-links">
    <a href="/apps/shimappu/terms">利用規約</a>
    <span>·</span>
    <a href="/apps/shimappu/privacy">プライバシーポリシー</a>
    <span>·</span>
    <a href="/apps/shimappu/tokusho">特定商取引法に基づく表示</a>
  </section>

  <style>
    /* 4枚構成の幅だけを指定し、筐体と操作UIはPlachieveの共通スタイルを利用します。 */
    .shimappu-carousel .studiair-carousel-track {
      width: 400%;
    }

    .shimappu-carousel .studiair-slide {
      width: 25%;
    }
  </style>
</BaseLayout>
