---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';

// FAQをデータとして管理し、番号・質問・回答の対応が崩れないようにします。
const faqItems = [
  {
    question: 'Plachieveのデータはどこに保存されますか？',
    answer: 'Plachieveで入力した予定、目標、テンプレート、UI設定などは、原則としてユーザーの端末内に保存されます。広告表示や課金処理に必要な情報は、Google AdMobやApple App Store / StoreKitが処理する場合があります。',
  },
  {
    question: 'Proプランの購入状態を復元できますか？',
    answer: 'アプリ内に復元機能がある場合、Apple App Store / StoreKitの購入情報に基づいてProプランの状態を復元できます。反映には通信環境やApple IDの状態により時間がかかる場合があります。',
  },
  {
    question: 'バックアップファイルには何が含まれますか？',
    answer: '予定、目標、テンプレート、設定などのアプリ内データが含まれる場合があります。Proプランの購入状態はバックアップファイルには含まれず、Appleの購入情報に基づいて復元されます。',
  },
  {
    question: '通知やウィジェットがすぐに反映されないことはありますか？',
    answer: 'はい。通知やウィジェットの更新は、iOSの仕様、端末の状態、集中モード、バッテリー状態、バックグラウンド更新の制限などに影響を受ける場合があります。',
  },
  {
    question: 'Studiairは現在利用できますか？',
    answer: 'Studiairは現在開発中です。公開時期や提供内容が決まり次第、サイト内のStudiairページでお知らせします。',
  },
  {
    question: '返信にはどのくらい時間がかかりますか？',
    answer: '内容を確認のうえ、可能な限り順次返信します。お問い合わせ内容によっては、確認や調査のためにお時間をいただく場合があります。',
  },
] as const;

const contactHref = `mailto:${SITE.contactEmail}`;
---

<BaseLayout
  page="contact"
  title="よくある質問とお問い合わせ｜Noveris"
  description="Noverisのよくある質問とお問い合わせページです。アプリやサポートに関する確認事項をご案内します。"
>
  <section class="contact-studio-hero" aria-labelledby="contact-page-title">
    <p class="contact-breadcrumb studio-mono">
      <a href="/">Noveris</a>
      <span aria-hidden="true">/</span>
      FAQ &amp; Contact
    </p>

    <div class="contact-meta studio-mono">
      <span>Support Desk — Japan</span>
      <span>{SITE.contactEmail}</span>
    </div>

    <h1 id="contact-page-title">よくある質問と<br />お問い合わせ</h1>
    <p class="contact-hero-copy">
      Noverisのアプリやサポートについて、よくある質問をまとめています。<br />
      解決しない場合は、ページ下部からメールでお問い合わせください。
    </p>
  </section>

  <section class="contact-faq-section" aria-labelledby="faq-title">
    <div class="contact-section-head">
      <h2 id="faq-title" class="studio-mono">01 — Frequently Asked Questions</h2>
      <span class="studio-mono">{String(faqItems.length).padStart(2, '0')} Entries</span>
    </div>

    <div class="contact-faq-list">
      {faqItems.map((item, index) => (
        <article class="contact-faq-item">
          <span class="contact-question-code studio-mono">Q-{String(index + 1).padStart(2, '0')}</span>
          <h3>{item.question}</h3>
          <p>{item.answer}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="contact-studio-band" aria-labelledby="contact-band-title">
    <div>
      <p class="studio-mono">02 — Contact</p>
      <h2 id="contact-band-title">解決しない場合は、<br />メールでご連絡ください。</h2>
      <p class="contact-band-copy">
        アプリ名、利用端末、OSバージョン、発生している内容を添えていただくと、状況を確認しやすくなります。
      </p>
    </div>
    <a href={contactHref} class="contact-mail-link studio-mono">
      Send an email →
    </a>
  </section>
</BaseLayout>
